{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Dark Grey", "color": "#5C5C5C" },
        { "slug": "paper", "name": "White", "color": "#ffffff" },
        { "slug": "sand", "name": "Light Grey", "color": "#EBEBEB" },
        { "slug": "accent", "name": "Accent Teal", "color": "#197E92" },
        { "slug": "accent-hover", "name": "Accent Dark", "color": "#146a7b" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Poppins\", sans-serif",
          "slug": "poppins",
          "name": "Poppins"
        }
      ]
    }
  }
}
